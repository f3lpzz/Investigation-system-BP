# Lixo de sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Dependências e ferramentas
node_modules/

# Segredos (precaução — não deve haver nenhum aqui)
.env
.env.*
# Chave service_role do Supabase, usada só localmente para subir o diretório
# de salas. NUNCA vai para o git nem para o site.
tools/chave-service.local.txt
# Artefato local do diretório de salas (regenerável; contém caminhos do PC)
app/diretorio-salas.json

# Backups automáticos do app e backups soltos
backups/
dados_backup_*.js

# Versão ONLINE: o catálogo real e as imagens locais do dono NÃO vão para o site
# publicado (privacidade). A versão online usa dados-vazio.js + imagens na nuvem.
app/dados.js
app/imagens/

# Fora do repositório: MVP local, cópias e artefatos de desenvolvimento.
_arquivo/

# Config local do Claude Code em qualquer subpasta
.claude/settings.local.json
**/.claude/settings.local.json
